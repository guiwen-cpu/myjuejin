# =====================================================================
# prod 环境变量模板（在服务器上复制为 .env.prod 后填写）
#   cp .env.prod.example .env.prod
# =====================================================================

# ---------- 端口（默认值，与本地开发一致）----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MEILI_HOST_PORT=7700

# ---------- 阿里云 ACR ----------
# 格式：registry.cn-<region>.aliyuncs.com/<namespace>
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# ---------- 数据库 / 中间件 ----------
POSTGRES_USER=devshare
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=devshare
MEILI_MASTER_KEY=change-me-meili-master-key

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# ---------- 站点（需与 GitHub 变量 NUXT_PUBLIC_SITE_URL_PROD 保持一致）----------
CORS_ORIGINS=https://www.example.com
NUXT_PUBLIC_SITE_URL=https://www.example.com
PUBLIC_API_URL=https://www.example.com

# ---------- 阿里云 OSS（可选，配置后上传走 OSS + CDN）----------
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=
