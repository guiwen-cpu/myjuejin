# ---------- 基础 ----------
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# ---------- 数据库 ----------
# 注意：密码需与仓库根目录 .env 的 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql://devshare:change-me-strong-password@localhost:5432/devshare?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
JWT_ACCESS_SECRET=devshare-access-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- Meilisearch ----------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=devshare-meili-master-key

# ---------- 上传（不配置 OSS 时使用本地磁盘）----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
PUBLIC_API_URL=http://localhost:3000

# ---------- 阿里云 OSS（可选，配置后上传走 OSS）----------
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=
