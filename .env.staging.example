# =====================================================================
# staging 环境变量模板（在服务器上复制为 .env.staging 后填写）
#   cp .env.staging.example .env.staging
# 端口与 prod 错开，避免同一台 ECS 上两套栈冲突。
# =====================================================================

# ---------- 端口（staging 与 prod 错开）----------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MEILI_HOST_PORT=17700

# ---------- 阿里云 ACR ----------
# 格式：registry.cn-<region>.aliyuncs.com/<namespace>
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# ---------- 数据库 / 中间件 ----------
POSTGRES_USER=devflow_staging
POSTGRES_PASSWORD=change-me-staging-password
POSTGRES_DB=devflow_staging
MEILI_MASTER_KEY=change-me-staging-meili-key

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=change-me-staging-jwt-secret

# ---------- 站点（需与 GitHub 变量 NUXT_PUBLIC_SITE_URL_STAGING 保持一致）----------
CORS_ORIGINS=http://<服务器IP>:8080
NUXT_PUBLIC_SITE_URL=http://<服务器IP>:8080
PUBLIC_API_URL=http://<服务器IP>:8080

# ---------- 阿里云 OSS（可选，配置后上传走 OSS + CDN）----------
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=
